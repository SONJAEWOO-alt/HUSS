# ===== 천안·아산 고용 미스매치 서비스 환경변수 예시 =====
# 이 파일을 server/.env 로 복사한 후 값을 채우세요.
# 실제 키는 .env 에만 두고 Git 커밋·프론트엔드 코드·로그에 절대 노출하지 마세요.

# --- Gemini AI (선택) ---
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급
# 미설정 시: AI 보고서는 "생성 불가"로 표시되고 정적 근거표만 제공됩니다 (전체 서비스 동작 유지)
GEMINI_API_KEY=
# 사용할 모델 (기본값: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Gemini 호출 타임아웃 ms (기본값: 45000)
GEMINI_TIMEOUT_MS=45000

# --- KOSIS 공식 OpenAPI (선택) ---
# KOSIS 통계정보 사이트(https://kosis.kr/openapi/)에서 일반 인증키 발급
# 미설정 시: "인증 필요·실제 호출 미검증" 상태로 표시되고 조회 코드·오류 처리만 동작합니다
KOSIS_API_KEY=
# KOSIS 호출 타임아웃 ms (기본값: 15000)
KOSIS_TIMEOUT_MS=15000

# --- 서버 포트 (선택) ---
# 백엔드 HTTP 포트 (기본값: 8787)
PORT=8787
# MCP 서버 Streamable HTTP 포트 (기본값: 8788)
MCP_PORT=8788
